DATABASE_PATH=./tickets.db
DOCUMENT_STORAGE_PATH=./storage
PDF_INGESTION_MODE=worker
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
SILICONFLOW_API_KEY=
# Optional: set this to your public domain when using compose.public.yaml.
SITE_DOMAIN=
